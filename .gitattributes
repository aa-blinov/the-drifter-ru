# Normalise line endings: the repository stores LF, every platform gets what
# it needs.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# The file the game reads is the one file that must keep CRLF: the importer
# takes the file as it is, and without CRLF it reads one long line. It also
# holds line breaks inside quoted fields, and normalisation would turn them
# into CRLF, so the file is stored and taken exactly as it is.
translation/Russian/translation.csv -text -eol

# Binary assets never get line-ending treatment.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp3 binary
*.mp4 binary
*.mov binary

# Keep diffs readable for generated and vendored files.
*.lock -diff
*.min.js -diff
*.min.css -diff
